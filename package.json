{
  "name": "pyro",
  "version": "0.3.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:packages": "pnpm --filter \"./packages/*\" -r run build",
    "build": "pnpm -r run build",
    "check": "pnpm run typecheck && pnpm run build && pnpm test",
    "dev": "concurrently -n gateway,control,dashboard -c blue,magenta,green \"pnpm --filter @pyro/gateway dev\" \"pnpm --filter @pyro/control-plane dev\" \"pnpm --filter @pyro/dashboard dev\"",
    "cloud:local": "node scripts/cloud-local.mjs",
    "cloud:local:mail": "node scripts/cloud-local.mjs mail",
    "cloud:local:stop": "node scripts/cloud-local.mjs stop",
    "cloud:staging:init": "node scripts/cloud-staging.mjs init",
    "cloud:staging:check": "node scripts/cloud-staging.mjs check",
    "cloud:staging:up": "node scripts/cloud-staging.mjs up",
    "test": "pnpm -r --stream --workspace-concurrency=1 run test",
    "typecheck": "pnpm run build:packages && pnpm -r run typecheck",
    "webhook:receiver": "node scripts/webhook-receiver.mjs",
    "test:webhook": "node scripts/test-webhook.mjs",
    "pyro": "node packages/cli/dist/bin.js",
    "evaluate": "node scripts/evaluate.mjs",
    "release:prepare": "node scripts/release-artifacts.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.3"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.10.0"
}
