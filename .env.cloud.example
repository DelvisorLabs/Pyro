# Production template. See docs/cloud.md; for staging use pnpm cloud:staging:init.
# Generate each secret separately: openssl rand -hex 32
POSTGRES_PASSWORD=
PYRO_RUNTIME_PASSWORD=
CONTROL_PLANE_SECRET=
CLOUD_PLATFORM_TOKEN=
CLOUD_DOMAIN=cloud.pyro.delvisor.com
CLOUD_API_DOMAIN=api.pyro.delvisor.com
ACME_EMAIL=
CLOUD_EMAIL_FROM=Pyro <accounts@your-verified-domain.example>
RESEND_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
# REQUIRED: verify your supplier's current price. USD per million tokens;
# requests reserve UTF-8 bytes as a conservative input-token estimate.
CLOUD_PROVIDER_PRICE_PER_MILLION=
# $30 maximum monthly reservation; also set a billing cap with the supplier.
CLOUD_PROVIDER_BUDGET_MICROS=30000000
CLOUD_MAX_ORGANIZATIONS=25
CLOUD_TRIAL_CREDITS=100
# Example pilot offer, configurable before selling. Confirm taxes/invoices separately.
CLOUD_PACK_PRICE_PAISE=199900
CLOUD_PACK_CREDITS=25000
# Leave blank to disable public checkout. Manual credits use the platform endpoint.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LOG_LEVEL=info
