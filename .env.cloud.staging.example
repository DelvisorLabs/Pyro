# Staging only. Run pnpm cloud:staging:init to generate unique secrets.
# This file is a template; .env.cloud.staging is gitignored and must stay private.
POSTGRES_PASSWORD=
PYRO_RUNTIME_PASSWORD=
CONTROL_PLANE_SECRET=
CLOUD_PLATFORM_TOKEN=

# Public IPv4 of the staging VM, used only by the preflight DNS check.
STAGING_VM_IPV4=
# Both names point to that same VM. Keep them separate from production names.
CLOUD_DOMAIN=staging.pyro.delvisor.com
CLOUD_API_DOMAIN=api.staging.pyro.delvisor.com
# A real inbox for Caddy's certificate account, not the account-email sender.
ACME_EMAIL=

# Verify the sender domain in Resend first, then use its API key.
CLOUD_EMAIL_FROM=
RESEND_API_KEY=

# Use a real provider key even for internet-facing staging.
TYPESAFE_API_KEY=
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_MODEL=jev-latest
# USD per million tokens: obtain/verify the provider's current price ceiling.
CLOUD_PROVIDER_PRICE_PER_MILLION=
# $5 monthly application reservation cap; also set the provider's own billing cap.
CLOUD_PROVIDER_BUDGET_MICROS=5000000
CLOUD_MAX_ORGANIZATIONS=5
CLOUD_TRIAL_CREDITS=20

# Leave payments disabled while testing staging.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
LOG_LEVEL=info
