{
  auto_https off
  admin off
}
:8080 {
  encode zstd gzip
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    X-Frame-Options DENY
  }
  route {
    @platform path /platform/* /control/platform/* /gateway/platform/*
    respond @platform 404
    handle_path /control/* {
      reverse_proxy cloud:8082
    }
    handle_path /gateway/* {
      reverse_proxy cloud:8082
    }
    @api path /v1/* /api/billing/webhook /health
    handle @api {
      reverse_proxy cloud:8082
    }
    handle {
      root * /srv
      try_files {path} /index.html
      file_server
    }
  }
}
