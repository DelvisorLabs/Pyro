{
  "name": "@pyro/cloud",
  "version": "0.3.0-beta.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "node --import tsx --test test/*.test.ts",
    "test:docker": "node test/docker-smoke.mjs",
    "test:edge": "node test/edge-smoke.mjs"
  },
  "dependencies": {
    "@pyro/contracts": "workspace:*",
    "@pyro/storage": "workspace:*",
    "@pyro/classifiers": "workspace:*",
    "@pyro/gateway": "workspace:*",
    "@pyro/control-plane": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.1",
    "ws": "^8.18.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6"
  },
  "files": [
    "dist"
  ]
}
